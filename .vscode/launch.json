{
  // WSL debug configs: open the repo with the VS Code "WSL" extension (run `code .` from Ubuntu)
  // and install Cortex-Debug inside WSL. Thread view needs CONFIG_DEBUG_THREAD_INFO=y.
  // Each config builds its lab first (asks for the board) via scripts/build_lab.sh,
  // which also links the board's openocd.cfg into the build dir.
  // Same lab order as .vscode/tasks.json.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Lab 01 (blinky)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build Lab 01 (blinky)",
      "executable": "${workspaceFolder}/build/01-blinky/zephyr/zephyr.elf",
      "servertype": "openocd",
      "serverpath": "/usr/bin/openocd",
      "gdbPath": "${userHome}/zephyr-sdk-0.17.2/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
      "configFiles": [
        "${workspaceFolder}/build/01-blinky/openocd.cfg"
      ],
      "rtos": "Zephyr",
      "runToEntryPoint": "main"
    },
    {
