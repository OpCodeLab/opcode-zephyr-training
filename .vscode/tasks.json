{
  // Terminal > Run Task...  (Ctrl+Shift+B runs "Build Lab 01 (blinky)")
  // Each lab has 3 tasks, in lab order: Build, Pristine build, Flash.
  // Generated list: keep the same order as .vscode/launch.json.
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "shell": {
      "executable": "bash",
      "args": [
        "-c"
      ]
    }
  },
  "tasks": [
    {
      "label": "Build Lab 01 (blinky)",
      "type": "shell",
      "command": "scripts/build_lab.sh labs/01-blinky build/01-blinky ${input:board}",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Pristine build Lab 01 (blinky)",
      "type": "shell",
      "command": "scripts/build_lab.sh labs/01-blinky build/01-blinky ${input:board} -p always",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Flash Lab 01 (blinky)",
      "type": "shell",
      "command": "source ../env.sh && west flash -d build/01-blinky",
      "problemMatcher": []
    },
    {
